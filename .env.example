# Copy to .env and fill in. .env is git-ignored; agents never read it
# (they check whether a key is set by name only).
# List every key the project uses here, with an empty value.

# ANTHROPIC_API_KEY=
# ELEVENLABS_API_KEY=
# OPENAI_API_KEY=

